<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="current-client.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Garrett Speager\Current Client">
    </Installer>
    <PackageInformation
        PackageName="Current Client"
        PackageDisplayName="Current Client"
        PublisherName="CN=Garrett Speager"
        PublisherDisplayName="Garrett Speager"
        Version="0.1.0.0"
        PackageDescription="A privacy-first Git client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.gspeager.current-client"
                Description="A privacy-first Git client"
                DisplayName="Current Client"
                ExecutableName="current-client.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Current Client</DisplayName>
            <PublisherDisplayName>Garrett Speager</PublisherDisplayName>
            <Description>A privacy-first Git client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="current-client.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
