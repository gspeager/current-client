# Auto detect text files and perform LF normalization
* text=auto

# Keep source files LF on Windows checkouts too, so gofmt and Prettier agree
# with the working tree regardless of core.autocrlf.
*.go text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.html text eol=lf
.prettierignore text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.scss text eol=lf
*.css text eol=lf
